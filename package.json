{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-token-usage-gui",
  "version": "0.2.0",
  "description": "Per-turn token, cache and cost footer for OpenCode Desktop.",
  "type": "module",
  "license": "MIT",
  "author": "AquariusCZ (https://github.com/AquariusCZ)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AquariusCZ/opencode-token-usage-gui.git"
  },
  "homepage": "https://github.com/AquariusCZ/opencode-token-usage-gui#readme",
  "bugs": {
    "url": "https://github.com/AquariusCZ/opencode-token-usage-gui/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-desktop",
    "token-usage",
    "deepseek",
    "cache",
    "cost"
  ],
  "exports": {
